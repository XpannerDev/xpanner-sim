  <xacro:property name="inr_probe_ixx" value="0.193"/> <xacro:property name="inr_probe_iyy" value="0.193"/><xacro:property name="inr_probe_izz" value="0.060"/> <!-- DERIVED, box 0.120 x 0.120 x 0.280 -->
