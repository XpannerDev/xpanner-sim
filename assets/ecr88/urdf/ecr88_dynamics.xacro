  <xacro:property name="inr_contact_surface_ixx" value="17.71"/><xacro:property name="inr_contact_surface_iyy" value="21.65"/><xacro:property name="inr_contact_surface_izz" value="39.26"/> <!-- DERIVED, box 1.200 x 1.085 x 0.060 (LenPLWidth x LenPanelHeight) -->

  <!-- ============================================================================
       [7]  BY PRODUCTS of the joint limit derivation. Not consumed by the URDF, but they
       are real recovered quantities and the next person will want them.
       ============================================================================ -->
  <xacro:property name="ref_bucket_radius"   value="0.780"/>  <!-- DERIVED [L39], INHERITS the H5 arm out stop ASSUMPTION  Volvo reference bucket pin to teeth radius, recovered from max digging reach A = 6 970 mm minus distChsToBmMnt_x, minus lenBm1 and lenArm, WITH THE ARM ASSUMED COLLINEAR. The former "confirmed by B, F and H" claim is WITHDRAWN: B and A are insensitive to the arm placement by construction and H is unreachable (H5). Weakly sensitive in the plausible range: 0.780 at out stop 0, 0.802 at -10 deg, 0.871 at -20 deg. eff_bucket and eff_arm are computed from this, so they move 44.6 -> 45.9 -> 49.8 kN.m and 98.7 -> 99.6 -> 102.3 kN.m across the same range. Volvo does not publish it. -->
  <xacro:property name="ref_boom_cyl_stroke" value="0.829"/>  <!-- DERIVED [L53]  from the mechanical boom range and the surveyed pin geometry. Retracted 1.351 m, ratio 1.63: an ordinary excavator cylinder. REPLACE with Teo's measured stroke. -->
  <xacro:property name="ref_arm_cyl_stroke"  value="0.833"/>  <!-- DERIVED [L54]  from the 124 deg arm sweep. Retracted 1.325 m, ratio 1.59: tight but realisable. REPLACE with Teo's measured stroke. -->
  <xacro:property name="ref_arm_deadcentre"  value="${deg * -5.6}"/> <!-- DERIVED [L55]  angCylLrgArm 144.4 deg and angCylSmlArm 150 deg are only 5.6 deg apart, so the arm cylinder passes through EXACT dead centre 5.6 deg before collinear. The arm's out stop is structural, not hydraulic. -->

  <!-- AUXILIARY HYDRAULIC CIRCUITS. Carried here ONLY so that the next person sizing the
       X1 PanelLift circuit reaches for the right stage's number. Nothing in the URDF reads
       these. THE TWO STAGES PUBLISH MATERIALLY DIFFERENT FIGURES and the widely quoted 35
       l/min is the Stage IIIB one; the emission stage is NOT confirmed (H4). "Slope and
       rotator" IS the tiltrotator supply, i.e. the circuit this build's tiltrotator and
       suction head actually hang off. -->
  <xacro:property name="aux_rotator_flow_lpm"      value="28.0"/>   <!-- PUBLISHED [L70]  Stage V product guide p.11 OPTIONAL EQUIPMENT, "Slope and rotator, max. flow 28 l/min (7.4 gal/min)". THE TILTROTATOR SUPPLY. The Stage IIIB brochure says 35 l/min: 25 % higher. Do not size on 35 until the serial plate is read. -->
  <xacro:property name="aux_rotator_press_mpa"     value="14.7"/>   <!-- PUBLISHED [L70]  14.7 MPa (2 130 psi). Identical on both stages. -->
  <xacro:property name="aux_rotator_flow_lpm_iiib" value="35.0"/>   <!-- PUBLISHED [L70]  Stage IIIB brochure, Optional Equipment. Here so the alternative is one edit away, NOT because it applies to the asserted machine. -->
  <xacro:property name="aux_breaker_flow_lpm"      value="118.0"/>  <!-- PUBLISHED [L71]  Stage V, X1 single (X1 double: 68 l/min). Informational: nothing here uses it. Stage IIIB brochure says 90 l/min. -->
  <xacro:property name="aux_breaker_press_mpa"     value="21.6"/>   <!-- PUBLISHED [L71]  Stage V, X1 single (X1 double: 29.4 MPa, which equals the implement relief). The Stage IIIB brochure's 32.4 MPa EXCEEDS the 29.4 MPa implement relief pressure that both stages publish: one more reason not to mix the stages' aux figures. -->

</robot>
